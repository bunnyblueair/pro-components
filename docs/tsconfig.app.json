{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "lib": ["esnext", "dom"],
    "paths": {
      "@/*": ["./src/*"],
      "#/*": ["./types/*"],
      "@antdv-vue/pro-layout": ["../packages/layout/src"],
      "@antdv-vue/pro-provider": ["../packages/provider/src"],
      "@antdv-vue/pro-field": ["../packages/field/src"],
      "@antdv-vue/pro-utils": ["../packages/utils/src"],
      "@antdv-vue/route-utils": ["../packages/route-utils/src"],
      "@antdv-vue/pro-listy": ["../packages/listy/src"],
      "@antdv-vue/pro-card": ["../packages/card/src"],
      "@antdv-vue/pro-form": ["../packages/form/src"],
      "@antdv-vue/pro-table": ["../packages/table/src"],
      "@antdv-vue/pro-descriptions": ["../packages/descriptions/src"],
      "@antdv-vue/pro-skeleton": ["../packages/skeleton/src"],
      "@antdv-vue/pro-components": ["../packages/components/src"]
    },
    "types": [
      "vite/client",
      "antdv-next/global"
    ],

    /* Linting */
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noUncheckedSideEffectImports": true
  },
  "files": [
    "types/md.d.ts",
    "types/vite-env.d.ts"
  ],
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    "types/**/*.d.ts",
    "types/**/*.ts"
  ]
}
